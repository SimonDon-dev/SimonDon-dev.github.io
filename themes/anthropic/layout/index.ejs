<!-- Hero / Personal Intro Section -->
<section class="hero">
  <div class="hero-inner">
    <div class="hero-avatar">
      <img src="<%- url_for('/images/avatar.png') %>" alt="<%= config.author %>" class="avatar-img">
    </div>
    <div class="hero-text">
      <h1 class="hero-name"><%= config.author %></h1>
      <p class="hero-subtitle"><%= config.subtitle || '' %></p>
      <p class="hero-description"><%= config.description || '' %></p>
    </div>
  </div>
</section>

<!-- Tags Overview -->
<% if (site.tags.length) { %>
<section class="tags-bar">
  <div class="tags-inner">
    <a href="<%- url_for('/tags') %>" class="tag-pill tag-all active">All Posts</a>
    <% site.tags.sort('name').each(function(tag){ %>
      <a href="<%- url_for(tag.path) %>" class="tag-pill"><%= tag.name %> <span class="tag-count"><%= tag.posts.length %></span></a>
    <% }) %>
  </div>
</section>
<% } %>

<!-- Post List -->
<section class="post-list">
  <div class="post-list-inner">
    <% page.posts.sort('date', -1).each(function(post){ %>
    <article class="post-card">
      <a href="<%- url_for(post.path) %>" class="post-card-link">
        <div class="post-card-content">
          <div class="post-meta">
            <time datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'MMM DD, YYYY') %></time>
            <% if (post.tags && post.tags.length) { %>
            <div class="post-tags-inline">
              <% post.tags.each(function(tag){ %>
                <span class="tag-inline"><%= tag.name %></span>
              <% }) %>
            </div>
            <% } %>
          </div>
          <h2 class="post-title"><%= post.title %></h2>
          <% if (post.excerpt) { %>
            <p class="post-excerpt"><%- strip_html(post.excerpt).substring(0, 200) %>...</p>
          <% } else { %>
            <p class="post-excerpt"><%- strip_html(post.content).substring(0, 200) %>...</p>
          <% } %>
          <span class="read-more">Read more →</span>
        </div>
      </a>
    </article>
    <% }) %>
  </div>
</section>

<!-- Pagination -->
<% if (page.total > 1) { %>
<nav class="pagination">
  <% if (page.prev) { %>
    <a href="<%- url_for(page.prev_link) %>" class="page-link prev">← Newer Posts</a>
  <% } %>
  <span class="page-number">Page <%= page.current %> of <%= page.total %></span>
  <% if (page.next) { %>
    <a href="<%- url_for(page.next_link) %>" class="page-link next">Older Posts →</a>
  <% } %>
</nav>
<% } %>
